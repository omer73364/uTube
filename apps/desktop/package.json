{
  "name": "@utube/desktop",
  "productName": "uTube",
  "version": "2.6.0",
  "description": "Public videos and audio from YouTube, X, Instagram, and Facebook",
  "private": true,
  "main": ".vite/build/main.cjs",
  "author": "OMER ANWAR",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "typecheck": "tsc --noEmit",
    "test:renderer": "node test/renderer.cjs",
    "test:desktop": "node test/bridge.cjs && node test/ui.cjs && node test/recovery.cjs && node test/preferences.cjs && node test/history.cjs && node test/ffmpeg-navigation.cjs && node test/x-downloads.cjs && node test/instagram-downloads.cjs && node test/facebook-downloads.cjs",
    "test:packaged": "node test/packaged.cjs",
    "test:updates": "node test/updates-ui.cjs",
    "test:file-size": "node test/file-size-ui.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "youtubei.js": "^18.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-base": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "app-builder-lib": "^26.15.3",
    "electron": "^44.9.0",
    "electron-squirrel-startup": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
