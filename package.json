{
  "name": "utube-cli",
  "version": "2.3.0",
  "description": "simple user friendly command line tool to download YouTube videos and playlists",
  "main": "index.js",
  "type": "module",
  "bin": {
    "utube": "index.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "desktop": "npm run start --workspace=@utube/desktop --",
    "desktop:check": "npm run typecheck --workspace=@utube/desktop",
    "desktop:package": "npm run package --workspace=@utube/desktop",
    "desktop:make": "npm run make --workspace=@utube/desktop",
    "desktop:test": "npm run test:desktop --workspace=@utube/desktop",
    "site:build": "node scripts/build-site.mjs",
    "site:preview": "npm run site:build && node scripts/serve-site.mjs",
    "site:test": "npm run site:build && node website/test/smoke.cjs",
    "desktop:test:packaged": "npm run test:packaged --workspace=@utube/desktop",
    "mobile:start": "npm run start --workspace=@utube/mobile",
    "mobile:android": "npm run android --workspace=@utube/mobile",
    "mobile:check": "npm run typecheck --workspace=@utube/mobile",
    "mobile:test": "npm run test --workspace=@utube/mobile",
    "mobile:build": "npm run build:android --workspace=@utube/mobile",
    "mobile:release": "npm run build:release --workspace=@utube/mobile"
  },
  "homepage": "https://omer73364.github.io/uTube/",
  "bugs": {
    "url": "https://github.com/omer73364/uTube/issues",
    "email": "anwar733649039@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omer73364/uTube.git"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "cli",
    "downloader",
    "playlists",
    "youtube",
    "terminal",
    "youtube-dl",
    "videos",
    "youtube-downloader"
  ],
  "author": "OMAR ANWAR",
  "license": "MIT",
  "dependencies": {
    "cli-progress": "^3.12.0",
    "inquirer": "^8.2.4",
    "ora": "^6.1.0",
    "terminal-kit": "^2.4.0",
    "youtubei.js": "^18.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "index.js",
    "version.js",
    "apps/cli/",
    "packages/core/",
    "docs/images/",
    "settings.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/distribution.md",
    "docs/ffmpeg-setup.md"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
